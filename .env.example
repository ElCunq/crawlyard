# Copy to .env and replace every value marked CHANGE_ME. .env is git-ignored.
# Generate secrets with: openssl rand -base64 24

DB_USER=crawlyard
DB_PASSWORD=CHANGE_ME
DB_NAME=crawlyard

REDIS_PASSWORD=CHANGE_ME

PANEL_USER=admin
# At least 12 characters; the panel refuses to start otherwise.
PANEL_PASSWORD=CHANGE_ME
PANEL_PORT=9090
# Domain served by the optional Caddy TLS proxy (--profile tls).
PANEL_DOMAIN=localhost

# Pause between jobs per worker. Keep it polite on sites you do not own.
WORKER_DELAY_MS=1000
# true = rotate SOCKS proxies from Redis (start the proxy-manager with --profile proxy)
USE_PROXY=false
